  SpreadsheetApp.getUi().alert('Aktif: setiap tanggal 1 jam 06.00, rekap bulan sebelumnya disimpan ke folder Laporan Bulanan.');
}

// =====================================================================
// WhatsApp (optional automatic sending through the Fonnte gateway)
// =====================================================================
function sendWhatsApp_(text) {
  var props = PropertiesService.getScriptProperties();
  var token = props.getProperty('WA_TOKEN'), target = props.getProperty('WA_TARGET');
  if (!token || !target) return { status: 'manual', reason: 'Pengiriman otomatis belum diaktifkan; pakai tombol WhatsApp di website.' };
  try {
    var res = UrlFetchApp.fetch('https://api.fonnte.com/send', {
      method: 'post', headers: { Authorization: token }, muteHttpExceptions: true,
      payload: { target: String(target).replace(/\D/g, ''), message: text, countryCode: '62' }
    });
    var body = {};
    try { body = JSON.parse(res.getContentText()); } catch (e) { body = {}; }
    if (res.getResponseCode() === 200 && body.status === true) return { status: 'sent' };
    return { status: 'error', error: String(body.reason || body.detail || ('HTTP ' + res.getResponseCode())) };
  } catch (err) {
    return { status: 'error', error: String(err.message || err) };
  }
}

// =====================================================================
// Delete a report (owner action, from the spreadsheet menu PCC > Hapus laporan…)
// The Reports row stays with status DELETED and the deletion is logged in Audit_Log.
// =====================================================================
function deleteReport_(reportId, reason) {
  reportId = String(reportId || '').trim();
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) throw new Error('Server sedang sibuk. Coba lagi sebentar.');
  try {
    var t = readTable_(SHEET.REPORTS), rep = null;
    t.rows.forEach(function (r) { if (r.report_id === reportId && r.status === 'ACTIVE') rep = r; });
    if (!rep) throw new Error('Laporan aktif dengan ID "' + reportId + '" tidak ditemukan.');
    deleteRowsWhere_(SHEET.COURT, 'report_id', reportId);
    deleteRowsWhere_(SHEET.SALES, 'report_id', reportId);
    deleteRowsWhere_(SHEET.OTHER, 'report_id', reportId);
    var now = new Date();
    writeObjectAt_(SHEET.REPORTS, rep._row, extend_(rep, { status: 'DELETED', updated_at: now }));
    appendObjects_(SHEET.AUDIT, [{
      timestamp: now, action: 'DELETE', report_id: reportId, report_key: rep.report_key, admin: rep.admin,
      submission_id: '', version: rep.version, grand_total: 0, payload_json: String(reason || '').slice(0, 500)
    }]);
    SpreadsheetApp.flush();
    var tanggal = String(rep.tanggal);
    var stillActive = activeReports_().some(function (r) { return r.tanggal === tanggal; });
    var archive = { status: 'skipped' };
    try { archive = stillActive ? rebuildArchive_(tanggal) : removeArchive_(tanggal); } catch (e) { archive = { status: 'error', error: String(e.message || e) }; }
    try { updateInventory_(tanggal.slice(0, 7), [tanggal]); } catch (e) { /* inventory is refreshed again on the next submit */ }
    return { ok: true, reportId: reportId, tanggal: tanggal, archive: archive };
  } finally {
    lock.releaseLock();
  }
}

/** No active report left for that date: move its archive file to the Drive trash and drop the index row. */
function removeArchive_(tanggal) {
  var index = readTable_(SHEET.ARCHIVE), entry = null;
  index.rows.forEach(function (r) { if (String(r.tanggal) === tanggal) entry = r; });
  if (!entry) return { status: 'skipped' };
  try { DriveApp.getFileById(entry.file_id).setTrashed(true); } catch (e) { /* already gone */ }
  index.sheet.deleteRows(entry._row, 1);
  return { status: 'removed' };
}

function menuDeleteReport() {
  var ui = SpreadsheetApp.getUi();
  var ask = ui.prompt('Hapus laporan', 'Masukkan ID laporan (contoh: PCC-20261117-0DA536):', ui.ButtonSet.OK_CANCEL);
  if (ask.getSelectedButton() !== ui.Button.OK) return;
  var id = ask.getResponseText().trim();
  if (ui.alert('Hapus laporan ' + id + '?', 'Baris booking, penjualan, dan pemasukan lainnya untuk laporan ini dihapus. Riwayatnya tetap tercatat di Audit_Log.', ui.ButtonSet.YES_NO) !== ui.Button.YES) return;
  var res = deleteReport_(id, 'Dihapus lewat menu PCC di spreadsheet');
  ui.alert('Laporan ' + res.reportId + ' (' + res.tanggal + ') dihapus. Arsip: ' + res.archive.status);
}

// =====================================================================
// Monthly folders and one-off maintenance (run from the Apps Script editor)
// =====================================================================
/** Subfolder `name` of `folder`, created the first time it is needed. */
function childFolder_(folder, name) {
  var it = folder.getFoldersByName(name);
  return it.hasNext() ? it.next() : folder.createFolder(name);
}

/** <REPORT_ROOT_FOLDER_ID>/LAPORAN YYYY/<BULAN YYYY> for a YYYY-MM or YYYY-MM-DD date, or null when the root is not set. */
function monthFolder_(date) {
  var rootId = PropertiesService.getScriptProperties().getProperty('REPORT_ROOT_FOLDER_ID');
  if (!rootId) return null;
  var p = String(date).split('-');
  var year = childFolder_(DriveApp.getFolderById(rootId), 'LAPORAN ' + p[0]);
  return childFolder_(year, MONTHS_ID[Number(p[1]) - 1] + ' ' + p[0]);
}

function recapEnabled_() {
  var props = PropertiesService.getScriptProperties();
  return !!(props.getProperty('REPORT_ROOT_FOLDER_ID') || props.getProperty('REKAP_FOLDER_ID'));
}

/** Folder for the REKAP BULAN file of `month` (YYYY-MM). */
function recapFolderFor_(month) {
  var m = monthFolder_(month);
  if (m) return childFolder_(m, 'Laporan Bulanan');
  return DriveApp.getFolderById(PropertiesService.getScriptProperties().getProperty('REKAP_FOLDER_ID'));
}

/** Folder for a date's archive: <root>/LAPORAN YYYY/<BULAN YYYY>/LAPORAN HARIAN when REPORT_ROOT_FOLDER_ID is set;
 *  otherwise ARCHIVE_FOLDER_ID, or its "NOVEMBER 2026" subfolder when ARCHIVE_MONTH_FOLDERS is true. */
function archiveFolderFor_(tanggal) {
  var m = monthFolder_(tanggal);
  if (m) return childFolder_(m, 'LAPORAN HARIAN');
  var props = PropertiesService.getScriptProperties();
  var folder = DriveApp.getFolderById(props.getProperty('ARCHIVE_FOLDER_ID'));
  if (String(props.getProperty('ARCHIVE_MONTH_FOLDERS')).toLowerCase() !== 'true') return folder;
  var p = String(tanggal).split('-');
  var name = MONTHS_ID[Number(p[1]) - 1] + ' ' + p[0];
  var it = folder.getFoldersByName(name);
  return it.hasNext() ? it.next() : folder.createFolder(name);
}

function moveIfElsewhere_(fileId, folder) {
  var file = DriveApp.getFileById(fileId);
  var parents = file.getParents();
  while (parents.hasNext()) { if (parents.next().getId() === folder.getId()) return false; }
  file.moveTo(folder);
  return true;
}

/** Moves every daily archive file listed in Archive_Index into its month folder. Returns how many were moved. */
function moveArchivesToMonthFolders() {
  var moved = 0;
  readTable_(SHEET.ARCHIVE).rows.forEach(function (r) {
    var t = String(r.tanggal);
    if (!/^\d{4}-\d{2}-\d{2}$/.test(t) || !r.file_id) return;
    try { if (moveIfElsewhere_(r.file_id, archiveFolderFor_(t))) moved++; } catch (e) { /* file deleted by hand */ }
  });
  Logger.log('Arsip dipindahkan: ' + moved);
  return moved;
}

/** One-off: moves every daily archive and REKAP BULAN file listed in Archive_Index to where the current settings
 *  put it, and the database spreadsheet itself into <root>/LAPORAN <this year>. Safe to run more than once. */
function moveAllToReportFolder() {
  var moved = 0;
  readTable_(SHEET.ARCHIVE).rows.forEach(function (r) {
    var t = String(r.tanggal);
    if (!r.file_id) return;
    var target = null;
    if (/^\d{4}-\d{2}-\d{2}$/.test(t)) target = archiveFolderFor_(t);
    else if (/^REKAP-\d{4}-\d{2}$/.test(t) && recapEnabled_()) target = recapFolderFor_(t.slice(6));
    if (!target) return;
    try { if (moveIfElsewhere_(r.file_id, target)) moved++; } catch (e) { /* file deleted by hand */ }
  });
  var rootId = PropertiesService.getScriptProperties().getProperty('REPORT_ROOT_FOLDER_ID');
  if (rootId) {
    var year = childFolder_(DriveApp.getFolderById(rootId), 'LAPORAN ' + Utilities.formatDate(new Date(), 'Asia/Jakarta', 'yyyy'));
    if (moveIfElsewhere_(SpreadsheetApp.getActiveSpreadsheet().getId(), year)) moved++;
  }
  Logger.log('File dipindahkan: ' + moved);
  return moved;
}

/** Saves last month's recap on the 1st of every month at 06.00 (Asia/Jakarta). Safe to run more than once. */
function installMonthlyTrigger() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'autoExportPreviousMonth') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('autoExportPreviousMonth').timeBased().onMonthDay(1).atHour(6).inTimezone('Asia/Jakarta').create();
  Logger.log('Pemicu rekap bulanan aktif');
  return 'ok';
}

/** Creates/refreshes this month's REKAP BULAN file now. */
function exportCurrentRecap() {
  var res = exportRecap_(Utilities.formatDate(new Date(), 'Asia/Jakarta', 'yyyy-MM'));
  Logger.log(res.title + ' ' + res.url);
  return res;
}

// =====================================================================
// Daily file in PCC's own "LAPORAN PEMASUKAN" format (DAILY_TEMPLATE_ID)
// The template is PCC's .xlsx saved as a Google Sheet. Every rebuild copies it and
// fills only the input cells, so its tabs, layout and formulas stay exactly as PCC made them.
// =====================================================================
var DAILY = { SUMMARY: 'Summary', BL: 'Booking Lapang', PJ: 'Penjualan & Penyewaan', CO: 'Coaching Abi Ipan', IK: 'Bookingan Internal-Komunitas' };
var DAILY_EXTRA = ['Event - Uang Kebersihan', 'Event - Uang Keamanan', 'Event - Pemasangan Alat', 'Biaya Tambahan Lain', 'Lainnya'];

/** Builds the daily file from the template; the previous file of that date goes to the trash. */
function rebuildDailyFromTemplate_(tanggal, title, folder, entry, reps, courts, sales, other) {
  var file = DriveApp.getFileById(PropertiesService.getScriptProperties().getProperty('DAILY_TEMPLATE_ID')).makeCopy(title, folder);
  var notes;
  try {
    notes = fillDailyReport_(SpreadsheetApp.openById(file.getId()), reps, courts, sales, other);
  } catch (err) {
    file.setTrashed(true);
    throw err;
  }
  if (entry && entry.file_id && entry.file_id !== file.getId()) {
    try { DriveApp.getFileById(entry.file_id).setTrashed(true); } catch (e) { /* already gone */ }
  }
  return { id: file.getId(), url: 'https://docs.google.com/spreadsheets/d/' + file.getId() + '/edit', notes: notes };
}

function dailyText_(v) { return String(v === null || v === undefined ? '' : v).replace(/\s+/g, ' ').trim(); }
function dailyCourt_(label) { var m = /court\s*(\d)/i.exec(dailyText_(label)); return m ? Number(m[1]) : null; }
function dailyNum_(v) { return Math.round((Number(v) || 0) * 100) / 100; }
function dailyName_(s) {
  var n = dailyText_(s).toLowerCase().replace(/[()]/g, ' ').replace(/\bfuits\b/, 'fruits').replace(/\s+/g, ' ').trim();
  return n === 'kara' ? 'kara coco' : n;
}

/** Reads one tab: values, formulas, and helpers to find blocks by the label in column B. */
function dailyGrid_(sh) {
  var rg = sh.getDataRange();
  var g = { sh: sh, v: rg.getValues(), f: rg.getFormulas(), writes: [] };
  g.b = function (r) { return dailyText_((g.v[r - 1] || [])[1]); };
  g.hasFormula = function (r, c) { return !!((g.f[r - 1] || [])[c - 1]); };
  g.val = function (r, c) { return (g.v[r - 1] || [])[c - 1]; };
  g.set = function (r, c, value) { if (!g.hasFormula(r, c)) g.writes.push([r, c, value]); };
  g.find = function (re, from) { for (var r = from || 1; r <= g.v.length; r++) if (re.test(g.b(r))) return r; return 0; };
  /** Rows after the block title (skipping header rows) up to its TOTAL row. */
  g.block = function (re, skip) {
    var start = g.find(re);
    if (!start) return [];
    var rows = [];
    for (var r = start + skip; r <= g.v.length && g.b(r).toUpperCase() !== 'TOTAL'; r++) rows.push(r);
    return rows;
  };
  g.flush = function () { g.writes.forEach(function (w) { sh.getRange(w[0], w[1]).setValue(w[2]); }); };
  return g;
}

/** Court rows of a block: [{row, court}] — a blank label continues the court above it. */
function dailyCourtRows_(g, rows) {
  var court = null;
  return rows.map(function (r) { court = dailyCourt_(g.b(r)) || court; return { row: r, court: court }; })
    .filter(function (x) { return x.court; });
}

/** Fills the copied template. Returns notes about anything that did not fit the format. */
function fillDailyReport_(ss, reps, courts, sales, other) {
  var notes = [];
  var bl = dailyGrid_(ss.getSheetByName(DAILY.BL));
  var pj = dailyGrid_(ss.getSheetByName(DAILY.PJ));
  var co = ss.getSheetByName(DAILY.CO) ? dailyGrid_(ss.getSheetByName(DAILY.CO)) : null;

  // ---- hours per court (top table) ----
  var hours = {}, total = 0;
  courts.forEach(function (c) { var h = dailyNum_(c.total_jam); hours[c.court] = dailyNum_((hours[c.court] || 0) + h); total = dailyNum_(total + h); });
  var top = bl.find(/^court$/i);
  var ayoStart = bl.find(/^booking by ayo/i);
  var firstCourtRow = 0;
  for (var r = top + 1; top && r < ayoStart; r++) {
    var n = dailyCourt_(bl.b(r));
    if (!n) continue;
    if (!firstCourtRow) firstCourtRow = r;
    bl.set(r, 3, hours[n] ? hours[n] + ' Jam' : '');
  }
  if (firstCourtRow) bl.set(firstCourtRow, 5, total ? total + ' jam' : '');

  // ---- AYO and manual bookings: one row per court + price ----
  [['AYO', /^booking by ayo/i], ['Manual', /^booking by manual/i]].forEach(function (k) {
    var slots = dailyCourtRows_(bl, bl.block(k[1], 1)).filter(function (x) { return bl.hasFormula(x.row, 7); });
    var groups = {};
    courts.filter(function (c) { return c.kategori === k[0]; }).forEach(function (c) {
      var key = c.court + '|' + Number(c.harga);
      var gr = groups[key] || (groups[key] = { court: Number(c.court), harga: Number(c.harga), jam: 0, metode: {} });
      gr.jam = dailyNum_(gr.jam + Number(c.total_jam));
      if (c.metode && c.metode !== 'BRI' && c.metode !== 'AYO') gr.metode[c.metode] = true;
    });
    var used = {};
    var place = function (gr, slot) {
      used[slot.row] = true;
      if (Number(bl.val(slot.row, 3)) !== gr.harga) bl.set(slot.row, 3, gr.harga);
      bl.set(slot.row, 4, gr.jam);
      var m = Object.keys(gr.metode);
      if (m.length) bl.set(slot.row, 8, 'Metode: ' + m.join(', '));
    };
    var left = [];
    Object.keys(groups).forEach(function (key) {
      var gr = groups[key];
      var hit = slots.filter(function (s) { return !used[s.row] && s.court === gr.court && Number(bl.val(s.row, 3)) === gr.harga; })[0];
      if (hit) place(gr, hit); else left.push(gr);
    });
    left.forEach(function (gr) {
      var free = slots.filter(function (s) { return !used[s.row] && s.court === gr.court; });
      if (free.length) place(gr, free[free.length - 1]);
      else notes.push('Booking ' + k[0] + ' Court ' + gr.court + ' ' + gr.jam + ' jam @' + gr.harga + ' tidak muat di tabel (baris harga penuh).');
    });
  });

  // ---- photoshoot / event per court: C = rate, D = hours, E/G/I = hours paid BRI/BCA/Mandiri ----
  var extraTotal = 0, extraText = [];
  [['Photoshoot', /^bookingan photoshoot/i, 14], ['Event - Lapangan', /^bookingan event/i, 15]].forEach(function (k) {
    var rows = dailyCourtRows_(bl, bl.block(k[1], 3));
    if (!rows.length) return;
    var per = {};
    other.filter(function (o) { return o.kategori === k[0]; }).forEach(function (o) {
      var c = dailyCourt_(o.keterangan) || rows[0].court;
      var p = per[c] || (per[c] = { jam: 0, nominal: 0, BRI: 0, BCA: 0, Mandiri: 0, ket: [] });
      var jam = Number(o.jam) || 1;
      p.jam = dailyNum_(p.jam + jam);
      p.nominal = dailyNum_(p.nominal + Number(o.nominal));
      p[o.metode === 'BCA' || o.metode === 'Mandiri' ? o.metode : 'BRI'] += jam;
      if (o.keterangan) p.ket.push(o.keterangan + (o.metode && o.metode !== 'BRI' ? ' (' + o.metode + ')' : ''));
    });
    Object.keys(per).forEach(function (c) {
      var p = per[c], row = rows.filter(function (x) { return x.court === Number(c); })[0] || rows[0];
      bl.set(row.row, 3, Math.round(p.nominal / p.jam * 100) / 100);
      bl.set(row.row, 4, p.jam);
      if (p.BRI) bl.set(row.row, 5, p.BRI);
      if (p.BCA) bl.set(row.row, 7, p.BCA);
      if (p.Mandiri) bl.set(row.row, 9, p.Mandiri);
      if (p.ket.length) bl.set(row.row, k[2], p.ket.join('; '));
    });
    if (k[0] === 'Event - Lapangan') {
      // Extra event charges go to "Biaya Tambahan Event" of the first court row (its TOTAL row adds that cell).
      other.filter(function (o) { return DAILY_EXTRA.indexOf(o.kategori) >= 0; }).forEach(function (o) {
        extraTotal = dailyNum_(extraTotal + Number(o.nominal));
        extraText.push(o.kategori.replace('Event - ', '') + (o.keterangan ? ' ' + o.keterangan : '') + ' ' + PCC.formatRupiah(o.nominal) + (o.metode && o.metode !== 'BRI' ? ' (' + o.metode + ')' : ''));
      });
      if (extraTotal) {
        bl.set(rows[0].row, 14, extraTotal);
        var ket = dailyText_(bl.val(rows[0].row, 15));
        bl.set(rows[0].row, 15, (ket ? ket + '; ' : '') + extraText.join('; '));
      }
    }
  });

  // ---- coaching: manual block, F = amount (L copies F), G = coach / method ----
  var coaching = other.filter(function (o) { return o.kategori === 'Coaching'; });
  if (coaching.length) {
    var crow = co ? co.block(/^booking manual coaching/i, 3) : [];
    if (!crow.length) notes.push('Coaching ' + coaching.length + ' baris tidak bisa ditulis: tabel coaching tidak ditemukan.');
    var buckets = crow.map(function () { return { n: 0, t: [] }; });
    coaching.forEach(function (o, i) {
      var b = buckets[Math.min(i, buckets.length - 1)];
      if (!b) return;
      b.n = dailyNum_(b.n + Number(o.nominal));
      b.t.push((o.keterangan || 'Coaching') + (o.metode ? ' (' + o.metode + ')' : ''));
    });
    buckets.forEach(function (b, i) { if (b.t.length) { co.set(crow[i], 6, b.n); co.set(crow[i], 7, b.t.join('; ')); } });
  }

  // ---- product sales per shift: E = qty (BRI/cash), G = qty paid BCA, H = qty via AYO ----
  var blocks = { 'Shift 1': pj.find(/^shift\s*1\b/i), 'Shift 2': pj.find(/^shift\s*2\b/i) };
  var totalStart = pj.find(/^total shift/i);
  var productRows = function (start) {
    var map = {};
    if (!start) return map;
    for (var r = start + 4; r <= pj.v.length && pj.b(r).toUpperCase() !== 'TOTAL'; r++) if (pj.b(r)) map[dailyName_(pj.b(r))] = r;
    return map;
  };
  var totalRows = productRows(totalStart);
  Object.keys(blocks).forEach(function (shift) {
    var start = blocks[shift];
    if (!start) return;
    var admins = reps.filter(function (r) { return r.shift === shift; }).map(function (r) { return r.admin; });
    pj.set(start, 2, shift + (admins.length ? ' ' + admins.join(' & ') : ''));
    var rowsByName = productRows(start);
    var agg = {};
    sales.filter(function (s) { return s.shift === shift; }).forEach(function (s) {
      var key = dailyName_(s.produk);
      var a = agg[key] || (agg[key] = { produk: s.produk, harga: Number(s.harga), qty: 0, bca: 0, ayo: 0 });
      if (s.metode === 'AYO') a.ayo += Number(s.qty); else a.qty += Number(s.qty);
      if (s.metode === 'BCA') a.bca += Number(s.qty);
    });
    Object.keys(agg).forEach(function (key) {
      var a = agg[key], r = rowsByName[key];
      if (!r) { notes.push(shift + ': produk "' + a.produk + '" (' + (a.qty + a.ayo) + ' x ' + PCC.formatRupiah(a.harga) + ') tidak ada di format, tidak ditulis.'); return; }
      if (Number(pj.val(r, 3)) !== a.harga) {
        pj.set(r, 3, a.harga);
        if (totalRows[key]) pj.set(totalRows[key], 3, a.harga);
        notes.push(shift + ': harga ' + a.produk + ' ' + PCC.formatRupiah(a.harga) + ' (berbeda dari format).');
      }
      pj.set(r, 5, a.qty);
      if (a.bca) pj.set(r, 7, a.bca);
      pj.set(r, 8, a.ayo);
    });
  });

  // ---- notes: admin notes + anything that did not fit, under the Summary table ----
  reps.forEach(function (r) { if (r.catatan) notes.push(r.shift + ' ' + r.admin + ': ' + r.catatan); });
  var sm = ss.getSheetByName(DAILY.SUMMARY);
  bl.flush(); pj.flush(); if (co) co.flush();
  if (sm && notes.length) {
    var at = dailyGrid_(sm).v.length + 2;
    sm.getRange(at, 2).setValue('Catatan');
    sm.getRange(at, 3).setValue(notes.join('\n'));
  }
  return notes;
}

/** One-off, from the editor: turns the Google Sheet in DAILY_TEMPLATE_ID into an empty template.
 *  Clears the sample day's inputs (cells with formulas are never touched) and lets the product
 *  TOTAL rows include the last product (Americano). */
function prepareDailyTemplate() {
  var ss = SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('DAILY_TEMPLATE_ID'));
  var bl = dailyGrid_(ss.getSheetByName(DAILY.BL));
  var top = bl.find(/^court$/i), ayoStart = bl.find(/^booking by ayo/i);
  for (var r = top + 1; top && r < ayoStart; r++) if (dailyCourt_(bl.b(r))) [3, 4, 5].forEach(function (c) { bl.set(r, c, ''); });
  dailyCourtRows_(bl, bl.block(/^booking by ayo/i, 1)).forEach(function (x) { [4, 5, 8].forEach(function (c) { bl.set(x.row, c, ''); }); });
  dailyCourtRows_(bl, bl.block(/^booking by manual/i, 1)).forEach(function (x) { [4, 5, 6, 8].forEach(function (c) { bl.set(x.row, c, ''); }); });
  [/^bookingan photoshoot/i, /^bookingan event/i, /^bookingan reclub/i].forEach(function (re, i) {
    bl.block(re, 3).forEach(function (r) { [4, 5, 6, 7, 8, 9, 10, 14, 15].concat(i === 2 ? [3] : []).forEach(function (c) { bl.set(r, c, ''); }); });
  });
  bl.flush();

  var pj = dailyGrid_(ss.getSheetByName(DAILY.PJ));
  var fixes = [];
  [/^shift\s*1\b/i, /^shift\s*2\b/i, /^total shift/i].forEach(function (re, i) {
    var start = pj.find(re);
    if (!start) return;
    if (i < 2) pj.set(start, 2, 'Shift ' + (i + 1));
    var first = start + 4, last = first, r = first;
    for (; r <= pj.v.length && pj.b(r).toUpperCase() !== 'TOTAL'; r++) {
      if (!pj.b(r)) continue;
      last = r;
      if (i < 2) { pj.set(r, 5, 0); pj.set(r, 6, ''); pj.set(r, 7, ''); pj.set(r, 8, 0); }
    }
    if (r <= pj.v.length) fixes.push([r, 9, '=SUM(I' + first + ':I' + last + ')'], [r, 10, '=SUM(J' + first + ':J' + last + ')']);
  });
  pj.flush();
  var s1 = pj.find(/^shift\s*1\b/i), s2 = pj.find(/^shift\s*2\b/i), st = pj.find(/^total shift/i);
  if (s1 && s2 && st) {
    // Shift-total rows add the same product row of both shifts (the template's last row pointed at TOTAL).
    var n1 = s1 + 4, n2 = s2 + 4;
    for (var t = st + 4; t <= pj.v.length && pj.b(t).toUpperCase() !== 'TOTAL'; t++, n1++, n2++) {
      if (pj.f[t - 1][4]) fixes.push([t, 5, '=E' + n1 + '+E' + n2]);
      if (pj.f[t - 1][7]) fixes.push([t, 8, '=H' + n1 + '+H' + n2]);
    }
  }
  fixes.forEach(function (x) { pj.sh.getRange(x[0], x[1]).setFormula(x[2]); });

  var ik = ss.getSheetByName(DAILY.IK);
  if (ik) {
    var g = dailyGrid_(ik);
    for (var i = 1; i <= g.v.length; i++) if (dailyCourt_(g.b(i))) [3, 4, 5].forEach(function (c) { g.set(i, c, ''); });
    g.flush();
  }
  var co = ss.getSheetByName(DAILY.CO);
  if (co) {
    var c2 = dailyGrid_(co);
    var gridEnd = c2.find(/^total$/i);
    for (var y = 4; y <= gridEnd; y++) for (var x = 3; x <= 14; x++) c2.set(y, x, '');
    c2.block(/^booking online/i, 3).forEach(function (row) { [4, 5].forEach(function (cc) { c2.set(row, cc, ''); }); });
    c2.block(/^booking manual coaching/i, 3).forEach(function (row) { [5, 6, 7, 8, 9, 10, 11].forEach(function (cc) { c2.set(row, cc, ''); }); });
    c2.flush();
  }
  ss.rename('TEMPLATE LAPORAN PEMASUKAN (WEB) - JANGAN DIHAPUS');
  var rootId = PropertiesService.getScriptProperties().getProperty('REPORT_ROOT_FOLDER_ID');
  if (rootId) moveIfElsewhere_(ss.getId(), childFolder_(DriveApp.getFolderById(rootId), 'LAPORAN ' + Utilities.formatDate(new Date(), 'Asia/Jakarta', 'yyyy')));
  Logger.log('Template siap: ' + ss.getName());
  return 'ok';
}

/** Rebuilds every daily file listed in Archive_Index (e.g. after switching to the template format). */
function rebuildAllArchives() {
  var dates = readTable_(SHEET.ARCHIVE).rows.map(function (r) { return String(r.tanggal); })
    .filter(function (t) { return /^\d{4}-\d{2}-\d{2}$/.test(t); });
  var ok = 0;
  dates.forEach(function (t) { var res = rebuildArchive_(t); if (res.status === 'ok') ok++; else Logger.log(t + ': ' + JSON.stringify(res)); });
  Logger.log('Arsip dibuat ulang: ' + ok + ' dari ' + dates.length);
  return ok;
}

// =====================================================================
// Monthly stock file: "INVENTORY STOKIES <BULAN YYYY> (WEB)" (INVENTORY_TEMPLATE_ID)
// One tab per stocked product, one row per day. The backend writes "Qty Keluar" = Shift 1 + Shift 2
// quantity of that product; stock in, complimentary rows and notes stay the admins' to fill.
// =====================================================================
var INV = { MASTER: 'Master Produk', FIRST: 8, ROWS: 31 };

function inventoryTitle_(month) {
  var p = String(month).split('-');
  return 'INVENTORY STOKIES ' + MONTHS_ID[Number(p[1]) - 1] + ' ' + p[0] + ' (WEB)';
}

/** Tab or product name -> key with the size kept ("Lestea 250 ml" -> "lestea 250ml"). */
function inventoryKey_(name) { return dailyName_(name).replace(/(\d+)\s*ml\b/g, '$1ml'); }
/** Same key without a trailing size, so tab "Pocari Sweet 500Ml" also takes product "Pocari Sweet". */
function inventoryBase_(name) { return inventoryKey_(name).replace(/\s*\d+ml$/, ''); }

function inventoryTabs_(ss) { return ss.getSheets().filter(function (sh) { return sh.getName() !== INV.MASTER; }); }

function shiftMonth_(month, delta) {
  var p = String(month).split('-').map(Number);
  var d = new Date(p[0], p[1] - 1 + delta, 1);
  return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2);
}

/** The month's stock file in <BULAN YYYY>; created from the template the first time (if `create`). */
function inventoryFile_(month, create) {
  var folder = monthFolder_(month);
  if (!folder) return null;
  var it = folder.getFilesByName(inventoryTitle_(month));
  if (it.hasNext()) return SpreadsheetApp.openById(it.next().getId());
  if (!create) return null;
  var file = DriveApp.getFileById(PropertiesService.getScriptProperties().getProperty('INVENTORY_TEMPLATE_ID')).makeCopy(inventoryTitle_(month), folder);
  var ss = SpreadsheetApp.openById(file.getId());
  initInventoryMonth_(ss, month);
  return ss;
}

/** New month: dates in column A, and the opening stock = last month's "Sisa Stok" of the same tab. */
function initInventoryMonth_(ss, month) {
  var p = month.split('-').map(Number);
  var days = new Date(p[0], p[1], 0).getDate();
  var prevMonth = shiftMonth_(month, -1);
  var prev = inventoryFile_(prevMonth, false);
  var prevName = MONTHS_ID[Number(prevMonth.split('-')[1]) - 1];
  prevName = prevName.charAt(0) + prevName.slice(1).toLowerCase();
  var tz = ss.getSpreadsheetTimeZone ? ss.getSpreadsheetTimeZone() : 'Asia/Jakarta';
  inventoryTabs_(ss).forEach(function (sh) {
    var opening = 0;
    if (prev) { var ps = prev.getSheetByName(sh.getName()); if (ps) opening = Number(ps.getRange(3, 3).getValue()) || 0; }
    sh.getRange(7, 1).setValue(prevName);
    sh.getRange(7, 3).setValue(opening);
    var rows = [];
    for (var i = 0; i < INV.ROWS; i++) rows.push(i < days ? [finDateObj_(month + '-' + ('0' + (i + 1)).slice(-2), tz), 'Keluar', 0, 0] : ['', '', '', '']);
    sh.getRange(INV.FIRST, 1, INV.ROWS, 4).setValues(rows);
  });
}

/** Writes "Qty Keluar" for the given dates (all YYYY-MM-DD of `month`); 0 when nothing was sold. */
function updateInventory_(month, dates) {
  var props = PropertiesService.getScriptProperties();
  if (!props.getProperty('INVENTORY_TEMPLATE_ID') || !props.getProperty('REPORT_ROOT_FOLDER_ID')) return { status: 'skipped' };
  var ss = inventoryFile_(month, true);
  var ids = {};
  activeReports_().forEach(function (r) { if (dates.indexOf(r.tanggal) >= 0) ids[r.report_id] = true; });
  var qty = {};
  readTable_(SHEET.SALES).rows.forEach(function (s) {
    if (!ids[s.report_id]) return;
    var key = String(s.tanggal) + '|' + inventoryKey_(s.produk);
    qty[key] = (qty[key] || 0) + (Number(s.qty) || 0);
    // Products sold without a size count for the tab of the same name with a size.
    if (inventoryKey_(s.produk) === inventoryBase_(s.produk)) {
      var bare = String(s.tanggal) + '|~' + inventoryBase_(s.produk);
      qty[bare] = (qty[bare] || 0) + (Number(s.qty) || 0);
    }
  });
  var tz = ss.getSpreadsheetTimeZone ? ss.getSpreadsheetTimeZone() : 'Asia/Jakarta';
  var written = 0;
  inventoryTabs_(ss).forEach(function (sh) {
    var key = inventoryKey_(sh.getName()), base = inventoryBase_(sh.getName());
    var last = sh.getLastRow();
    if (last < INV.FIRST) return;
    var v = sh.getRange(INV.FIRST, 1, last - INV.FIRST + 1, 10).getValues();
    var done = {};
    v.forEach(function (row, i) {
      if (Object.prototype.toString.call(row[0]) !== '[object Date]') return;
      if (String(row[9]).trim().toLowerCase() === 'yes') return; // complimentary rows are the admins'
      var t = Utilities.formatDate(row[0], tz, 'yyyy-MM-dd');
      if (dates.indexOf(t) < 0 || done[t]) return;
      done[t] = true;
      var q = (qty[t + '|' + key] || 0) + (key !== base ? qty[t + '|~' + base] || 0 : 0);
      if (Number(row[3]) !== q || row[3] === '') sh.getRange(INV.FIRST + i, 4).setValue(q);
      written++;
    });
  });
  return { status: 'ok', url: ss.getUrl(), title: inventoryTitle_(month), rows: written };
}

/** From the editor: rewrites "Qty Keluar" of every day of a month (default: this month) up to today. */
function rebuildInventoryMonth(month) {
  month = /^\d{4}-\d{2}$/.test(String(month)) ? month : Utilities.formatDate(new Date(), 'Asia/Jakarta', 'yyyy-MM');
  var today = Utilities.formatDate(new Date(), 'Asia/Jakarta', 'yyyy-MM-dd');
  var p = month.split('-').map(Number), dates = [];
  for (var d = 1; d <= new Date(p[0], p[1], 0).getDate(); d++) {
    var t = month + '-' + ('0' + d).slice(-2);
    if (t <= today) dates.push(t);
  }
  var res = updateInventory_(month, dates);
  Logger.log(JSON.stringify(res));
  return res;
}

/** Products that are counted as stock: Master_Produk rows of these groups (rentals are not stock). */
var INV_GROUPS = ['Minuman', 'Snack'];

/** Adds a tab (copy of an existing product tab, emptied) for `name`, plus its row in 'Master Produk'. */
function addInventoryTab_(ss, name, modal, jual) {
  var tabs = inventoryTabs_(ss);
  if (!tabs.length) throw new Error('Tidak ada tab produk untuk dicontoh di ' + ss.getName());
  var model = tabs[tabs.length - 1];
  var oldLookup = null;
  var f7 = model.getRange(7, 6).getFormula();
  var m = /VLOOKUP\("([^"]+)"/.exec(f7);
  if (m) oldLookup = m[1];
  var sh = model.copyTo(ss);
  sh.setName(name);
  if (oldLookup) sh.createTextFinder('"' + oldLookup + '"').matchFormulaText(true).replaceAllWith('"' + name + '"');
  sh.getRange(1, 1).setValue('INVENTORY - ' + name.toUpperCase());
  sh.getRange(4, 1).setValue('Harga Modal: ' + (modal ? PCC.formatRupiah(modal) : '-'));
  sh.getRange(4, 3).setValue('Harga Jual: ' + PCC.formatRupiah(jual));
  sh.getRange(7, 3).setValue(0);
  var last = sh.getLastRow();
  if (last >= INV.FIRST) {
    var n = last - INV.FIRST + 1;
    var dates = sh.getRange(INV.FIRST, 1, n, 1).getValues();
    var cd = sh.getRange(INV.FIRST, 3, n, 2).getValues();
    sh.getRange(INV.FIRST, 3, n, 2).setValues(cd.map(function (row, i) { return dates[i][0] === '' ? row : [0, 0]; }));
    sh.getRange(INV.FIRST, 10, n, 2).setValues(dates.map(function () { return ['', '']; }));
  }
  var mp = ss.getSheetByName(INV.MASTER);
  if (mp) {
    var names = mp.getRange(1, 2, Math.max(mp.getLastRow(), 1), 1).getValues().map(function (x) { return inventoryKey_(x[0]); });
    if (names.indexOf(inventoryKey_(name)) < 0) {
      var row = mp.getLastRow() + 1;
      mp.getRange(row, 1, 1, 5).setValues([[row - 1, name, modal || '', jual, 'Pcs']]);
    }
  }
  return sh;
}

/** From the editor: every drink/snack in Master_Produk without a tab gets one, in the template and in
 *  this month's stock file (then this month's "Qty Keluar" is filled again). Safe to run more than once. */
function addInventoryProducts() {
  var props = PropertiesService.getScriptProperties();
  var month = Utilities.formatDate(new Date(), 'Asia/Jakarta', 'yyyy-MM');
  var targets = [SpreadsheetApp.openById(props.getProperty('INVENTORY_TEMPLATE_ID'))];
  var current = inventoryFile_(month, false);
  if (current) targets.push(current);
  var products = readTable_(SHEET.PRODUCTS).rows.filter(function (p) {
    return INV_GROUPS.indexOf(String(p.grup)) >= 0 && String(p.aktif) !== 'false' && p.aktif !== false;
  });
  var added = [];
  targets.forEach(function (ss) {
    var have = inventoryTabs_(ss).map(function (sh) { return [inventoryKey_(sh.getName()), inventoryBase_(sh.getName())]; });
    products.forEach(function (p) {
      var k = inventoryKey_(p.produk);
      var exists = have.some(function (h) { return h[0] === k || (k === inventoryBase_(p.produk) && h[1] === k); });
      if (exists) return;
      addInventoryTab_(ss, String(p.produk), Number(p.harga_modal) || 0, Number(p.harga) || 0);
      have.push([k, inventoryBase_(p.produk)]);
      added.push(ss.getName() + ': ' + p.produk);
    });
  });
  if (current) rebuildInventoryMonth(month);
  Logger.log('Tab ditambahkan (' + added.length + '):\n' + added.join('\n'));
  return added;
}

/** From the editor, once (safe to run again): brings the live Master_Produk in line with SEED_PRODUCTS.
 *  RETIRED_PRODUCTS get aktif = FALSE (old reports keep their names); seed products that are missing are
 *  added after the last row of their grup, so the form and WhatsApp list keep the grouped order.
 *  Existing rows (prices edited by the owner) are left as they are. Then stock tabs are added for the new items. */
function updateProdukNov2026() {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET.PRODUCTS);
  if (!sh) throw new Error('Sheet "' + SHEET.PRODUCTS + '" tidak ada. Jalankan setup() dulu.');
  var values = sh.getDataRange().getValues();
  var headers = values[0];
  var col = {};
  headers.forEach(function (h, j) { col[h] = j; });
  ['produk', 'harga', 'harga_modal', 'aktif', 'grup', 'label_wa'].forEach(function (h) {
    if (!(h in col)) throw new Error('Kolom "' + h + '" tidak ada di ' + SHEET.PRODUCTS);
  });
  var key = function (s) { return String(s).trim().toLowerCase(); };
  var rows = values.slice(1); // blank rows kept so nothing below them shifts out of place
  var retired = RETIRED_PRODUCTS.map(key);
  var log = [];
  rows.forEach(function (r) {
    if (retired.indexOf(key(r[col.produk])) >= 0 && String(r[col.aktif]).toUpperCase() !== 'FALSE') {
      r[col.aktif] = false;
      log.push('Nonaktif: ' + r[col.produk]);
    }
  });
  SEED_PRODUCTS.forEach(function (p) {
    if (rows.some(function (r) { return key(r[col.produk]) === key(p[0]); })) return;
    var row = headers.map(function () { return ''; });
    row[col.produk] = p[0]; row[col.harga] = p[1]; row[col.harga_modal] = p[2];
    row[col.aktif] = true; row[col.grup] = p[3]; row[col.label_wa] = p[4];
    var at = rows.length;
    for (var i = rows.length - 1; i >= 0; i--) { if (String(rows[i][col.grup]) === p[3]) { at = i + 1; break; } }
    rows.splice(at, 0, row);
    log.push('Ditambah: ' + p[0] + ' (' + p[3] + ', jual ' + p[1] + ', modal ' + p[2] + ')');
  });
  if (rows.length) sh.getRange(2, 1, rows.length, headers.length).setValues(rows);
  if (PropertiesService.getScriptProperties().getProperty('INVENTORY_TEMPLATE_ID')) {
    addInventoryProducts().forEach(function (a) { log.push('Tab stok: ' + a); });
  }
  Logger.log(log.length ? log.join('\n') : 'Master_Produk sudah sesuai, tidak ada perubahan.');
  return log;
}

// =====================================================================
// KEUANGAN (manager only, MANAGER_PIN): Petty Cash ledger + Pengajuan & Reimbursment
//   PETTY_CASH_ID          Google Sheet "Report Arus Keuangan Petty Cash (WEB)" (one running ledger)
//   PENGAJUAN_FOLDER_ID    folder "PENGAJUAN & REIMBURSMENT" (one file per pengajuan date)
//   PENGAJUAN_TEMPLATE_ID  Google Sheet template of PCC's pengajuan form
//   BUKTI_FOLDER_ID        folder "BUKTI & LAMPIRAN" (uploads go to "2026-11 NOVEMBER" subfolders)
// =====================================================================
var FIN = {
  ITEMS: 'Fin_Pengajuan', LOG: 'Fin_Log',
  LEDGER_FIRST: 4, MAX_UPLOAD: 15 * 1024 * 1024,
  PJ_FIRST: 5, PJ_ROWS: 21
};
var FIN_HEADERS = {
  Fin_Pengajuan: ['item_id', 'tanggal_pengajuan', 'keterangan', 'qty', 'kategori', 'satuan', 'nominal', 'dp', 'tanggal_dp',
    'atas_nama', 'no_rekening', 'bank', 'source', 'nota', 'status', 'tanggal_bayar', 'bukti_bayar', 'created_at', 'updated_at'],
  Fin_Log: ['timestamp', 'action', 'detail']
};
Object.keys(FIN_HEADERS).forEach(function (k) { HEADERS[k] = FIN_HEADERS[k]; });

function checkManagerPin_(pin) {
  var expected = PropertiesService.getScriptProperties().getProperty('MANAGER_PIN');
  if (!expected) throw new Error('Server belum dikonfigurasi (MANAGER_PIN kosong).');
  var cache = CacheService.getScriptCache();
  var fails = Number(cache.get('mgr_pin_fails') || 0);
  if (fails >= 10) throw new Error('Terlalu banyak percobaan PIN salah. Coba lagi dalam 10 menit.');
  if (String(pin || '') !== String(expected)) {
    cache.put('mgr_pin_fails', String(fails + 1), 600);
    throw new Error('PIN salah.');
  }
}

/** Router for every "fin_*" action. */
function finance_(req) {
  checkManagerPin_(req.pin);
  finSetup_();
  switch (req.action) {
    case 'fin_ping': return { ok: true };
    case 'fin_summary': return { ok: true, data: finSummary_() };
    case 'fin_petty_add': return finLocked_(function () { return finPettyAdd_(req.entry, req.files); });
    case 'fin_petty_update': return finLocked_(function () { return finPettyUpdate_(req.row, req.fp, req.entry, req.files, req.keep); });
    case 'fin_petty_delete': return finLocked_(function () { return finPettyDelete_(req.row, req.fp); });
    case 'fin_pengajuan_save': return finLocked_(function () { return finPengajuanSave_(req.tanggal, req.items, req.files); });
    case 'fin_pengajuan_pay': return finLocked_(function () { return finPengajuanPay_(req.itemIds, req.tanggalBayar, req.files, req.via); });
    case 'fin_pengajuan_delete': return finLocked_(function () { return finPengajuanDelete_(req.itemId); });
    default: throw new Error('Aksi tidak dikenal.');
  }
}

function finLocked_(fn) {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) throw new Error('Server sedang sibuk. Coba lagi sebentar.');
  try { return fn(); } finally { lock.releaseLock(); }
}

/** Creates the finance tabs in the database spreadsheet the first time. */
function finSetup_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  Object.keys(FIN_HEADERS).forEach(function (name) {
    if (ss.getSheetByName(name)) return;
    var sh = ss.insertSheet(name);
    sh.getRange(1, 1, 1, FIN_HEADERS[name].length).setValues([FIN_HEADERS[name]]).setFontWeight('bold');
    sh.setFrozenRows(1);
  });
}

function finLog_(action, detail) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(FIN.LOG);
  sh.getRange(sh.getLastRow() + 1, 1, 1, 3).setValues([[new Date(), action, JSON.stringify(detail).slice(0, 2000)]]);
}

function finProp_(key) {
  var v = PropertiesService.getScriptProperties().getProperty(key);
  if (!v) throw new Error(key + ' belum diisi di Script properties.');
  return v;
}

function finDate_(t) {
  if (!PCC.isValidDate(String(t))) throw new Error('Tanggal tidak valid.');
  return String(t);
}
/** YYYY-MM-DD -> Date at midnight in `tz` (the target spreadsheet's time zone), so the sheet shows that exact day. */
function finDateObj_(t, tz) {
  if (tz) return Utilities.parseDate(String(t), tz, 'yyyy-MM-dd');
  var p = String(t).split('-').map(Number); return new Date(p[0], p[1] - 1, p[2]);
}
/** Time zone of the spreadsheet a sheet belongs to (files converted from .xlsx may not be Asia/Jakarta). */
function sheetTz_(sh) {
  try { var z = sh.getParent().getSpreadsheetTimeZone(); return typeof z === 'string' && z ? z : 'Asia/Jakarta'; } catch (e) { return 'Asia/Jakarta'; }
}
function finText_(v, max) { return String(v === null || v === undefined ? '' : v).replace(/\s+/g, ' ').trim().slice(0, max || 200); }
function finMoney_(v) { var n = PCC.toNum(v); return n > 0 ? n : 0; }

// ---------------- uploads: BUKTI & LAMPIRAN/<YYYY-MM BULAN>/<tanggal> <label>.<ext> ----------------
function buktiFolder_(tanggal) {
  var p = String(tanggal).split('-');
  return childFolder_(DriveApp.getFolderById(finProp_('BUKTI_FOLDER_ID')), p[0] + '-' + p[1] + ' ' + MONTHS_ID[Number(p[1]) - 1]);
}

/** files: [{name, mime, data(base64)}] -> list of Drive URLs. */
function saveBukti_(files, tanggal, label) {
  files = (files || []).filter(function (f) { return f && f.data; });
  if (!files.length) return [];
  var total = files.reduce(function (s, f) { return s + String(f.data).length * 0.75; }, 0);
  if (total > FIN.MAX_UPLOAD) throw new Error('Total lampiran terlalu besar (maks 15 MB). Kurangi jumlah/ukuran foto.');
  var folder = buktiFolder_(tanggal);
  var base = tanggal + ' ' + finText_(label, 80).replace(/[\\/:*?"<>|#%]/g, '-');
  return files.map(function (f, i) {
    var ext = (/\.[A-Za-z0-9]{2,5}$/.exec(String(f.name || '')) || ['.jpg'])[0].toLowerCase();
    var name = base + (files.length > 1 ? ' (' + (i + 1) + ')' : '') + ext;
    var blob = Utilities.newBlob(Utilities.base64Decode(String(f.data)), String(f.mime || 'application/octet-stream'), name);
    return folder.createFile(blob).getUrl();
  });
}

// ---------------- Petty Cash ledger (H Date, I Transaksi, J Kredit, K Debit, L Category, M Ke Account, N Struk Nota) ----------------
function ledger_() {
  var ss = SpreadsheetApp.openById(finProp_('PETTY_CASH_ID'));
  return { ss: ss, sh: ss.getSheets()[0] };
}

function ledgerLastRow_(sh) {
  var last = sh.getLastRow();
  if (last < FIN.LEDGER_FIRST) return FIN.LEDGER_FIRST - 1;
  var v = sh.getRange(FIN.LEDGER_FIRST, 8, last - FIN.LEDGER_FIRST + 1, 4).getValues();
  for (var i = v.length - 1; i >= 0; i--) if (v[i].join('') !== '') return FIN.LEDGER_FIRST + i;
  return FIN.LEDGER_FIRST - 1;
}

function ledgerRows_(sh) {
  var last = ledgerLastRow_(sh);
  if (last < FIN.LEDGER_FIRST) return [];
  var n = last - FIN.LEDGER_FIRST + 1;
  var vals = sh.getRange(FIN.LEDGER_FIRST, 8, n, 9).getValues();
  var shown = sh.getRange(FIN.LEDGER_FIRST, 8, n, 7).getDisplayValues();
  var tz = sheetTz_(sh);
  return vals.map(function (v, i) {
    var d = v[0];
    var iso = Object.prototype.toString.call(d) === '[object Date]' ? Utilities.formatDate(d, tz, 'yyyy-MM-dd') : '';
    return {
      row: FIN.LEDGER_FIRST + i, tanggal: iso, tanggalText: shown[i][0], transaksi: String(v[1]),
      kredit: Number(v[2]) || 0, debit: Number(v[3]) || 0, kategori: String(v[4]), akun: String(v[5]),
      nota: String(v[6]), ref: String(v[8] || ''), fp: finFingerprint_(shown[i])
    };
  });
}

function finFingerprint_(displayRow) {
  var s = displayRow.join('|'), h = 0;
  for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
  return String(h);
}

function pettyEntry_(e) {
  e = e || {};
  var out = { tanggal: finDate_(e.tanggal), transaksi: finText_(e.transaksi, 200), kredit: finMoney_(e.kredit), debit: finMoney_(e.debit),
    kategori: finText_(e.kategori, 60), akun: finText_(e.akun, 80) };
  if (!out.transaksi) throw new Error('Nama transaksi wajib diisi.');
  if (!out.kredit && !out.debit) throw new Error('Isi nominal Kredit (masuk) atau Debit (keluar).');
  return out;
}

function writeLedgerRow_(sh, row, e, nota) {
  sh.getRange(row, 8, 1, 7).setValues([[finDateObj_(e.tanggal, sheetTz_(sh)), e.transaksi, e.kredit || '', e.debit || '', e.kategori, e.akun, nota]]);
  sh.getRange(row, 8).setNumberFormat(LEDGER_DATE_FORMAT);
}

function finPettyAdd_(entry, files) {
  var e = pettyEntry_(entry);
  var links = saveBukti_(files, e.tanggal, e.transaksi);
  var L = ledger_();
  var last = ledgerLastRow_(L.sh), row = last + 1;
  if (row > L.sh.getMaxRows()) L.sh.insertRowsAfter(L.sh.getMaxRows(), 50);
  if (last >= FIN.LEDGER_FIRST) L.sh.getRange(last, 8, 1, 7).copyTo(L.sh.getRange(row, 8, 1, 7), { formatOnly: true });
  writeLedgerRow_(L.sh, row, e, links.join('\n'));
  sortLedger_(L.sh);
  finLog_('PETTY_ADD', { row: row, entry: e, files: links.length });
  return { ok: true, row: row, links: links, saldo: Number(L.sh.getRange(3, 5).getValue()) || 0 };
}

function ledgerRowChecked_(sh, row, fp) {
  row = Number(row);
  var rows = ledgerRows_(sh).filter(function (r) { return r.row === row; });
  if (!rows.length || rows[0].fp !== String(fp)) throw new Error('Baris ini sudah berubah di spreadsheet. Muat ulang data lalu coba lagi.');
  return rows[0];
}

function finPettyUpdate_(row, fp, entry, files, keep) {
  var L = ledger_();
  var old = ledgerRowChecked_(L.sh, row, fp);
  if (old.ref) throw new Error('Transaksi ini dibuat otomatis dari Pengajuan. Ubah lewat menu Pengajuan.');
  var e = pettyEntry_(entry);
  var links = saveBukti_(files, e.tanggal, e.transaksi);
  var nota = keepLinks_(old.nota, keep).concat(links).join('\n');
  writeLedgerRow_(L.sh, Number(row), e, nota);
  sortLedger_(L.sh);
  finLog_('PETTY_UPDATE', { row: row, before: old, after: e, files: links.length });
  return { ok: true, row: Number(row), links: links };
}

function finPettyDelete_(row, fp) {
  var L = ledger_();
  var old = ledgerRowChecked_(L.sh, row, fp);
  if (old.ref) throw new Error('Transaksi ini dibuat otomatis dari Pengajuan. Hapus/batalkan lewat menu Pengajuan.');
  L.sh.deleteRow(Number(row));
  finLog_('PETTY_DELETE', { row: row, before: old });
  return { ok: true };
}

// ---------------- Pengajuan & Reimbursment ----------------
function pjItem_(raw, tanggal) {
  raw = raw || {};
  var it = {
    item_id: finText_(raw.item_id, 40), tanggal_pengajuan: tanggal, keterangan: finText_(raw.keterangan, 200),
    qty: PCC.toNum(raw.qty) || 1, kategori: finText_(raw.kategori, 60), satuan: finText_(raw.satuan, 30),
    nominal: finMoney_(raw.nominal), dp: finMoney_(raw.dp), tanggal_dp: raw.tanggal_dp ? finDate_(raw.tanggal_dp) : '',
    atas_nama: finText_(raw.atas_nama, 80), no_rekening: finText_(raw.no_rekening, 40).replace(/[^0-9\- ]/g, ''),
    bank: finText_(raw.bank, 40), source: finText_(raw.source, 60)
  };
  if (!it.keterangan) throw new Error('Keterangan item wajib diisi.');
  if (!it.nominal) throw new Error('Nominal "' + it.keterangan + '" wajib diisi.');
  return it;
}

/** Items with plain YYYY-MM-DD dates (Sheets turns typed dates into Date values). */
function pjRows_() {
  return readTable_(FIN.ITEMS).rows.map(function (r) {
    var o = cleanRecord_(r);
    ['tanggal_pengajuan', 'tanggal_bayar', 'tanggal_dp'].forEach(function (k) { o[k] = String(o[k] || '').slice(0, 10); });
    return o;
  });
}

/** items: [{item_id?, keterangan, qty, ...}], files: {index: [file...]} — new items and edits for one pengajuan date. */
function finPengajuanSave_(tanggal, items, files) {
  tanggal = finDate_(tanggal);
  if (!items || !items.length) throw new Error('Tambahkan minimal satu item.');
  var table = readTable_(FIN.ITEMS), now = new Date(), saved = [];
  items.forEach(function (raw, i) {
    var it = pjItem_(raw, tanggal);
    var links = saveBukti_((files || {})[i], tanggal, 'Pengajuan ' + it.keterangan);
    var existing = it.item_id ? table.rows.filter(function (r) { return r.item_id === it.item_id; })[0] : null;
    if (existing) {
      var rec = extend_(cleanRecord_(existing), it);
      rec.nota = keepLinks_(existing.nota, raw.nota_keep).concat(links).join('\n');
      rec.bukti_bayar = keepLinks_(existing.bukti_bayar, raw.bayar_keep).join('\n');
      rec.updated_at = now;
      delete rec._row;
      writeObjectAt_(FIN.ITEMS, existing._row, rec);
      saved.push(rec.item_id);
    } else {
      it.item_id = 'PJ-' + tanggal.replace(/-/g, '') + '-' + Utilities.getUuid().slice(0, 6).toUpperCase();
      it.nota = links.join('\n'); it.status = 'Diajukan'; it.tanggal_bayar = ''; it.bukti_bayar = '';
      it.created_at = now; it.updated_at = now;
      appendObjects_(FIN.ITEMS, [it]);
      saved.push(it.item_id);
    }
  });
  SpreadsheetApp.flush();
  var file = rebuildPengajuanFile_(tanggal);
  syncPettyFromPengajuan_(saved);
  finLog_('PJ_SAVE', { tanggal: tanggal, items: saved });
  return { ok: true, tanggal: tanggal, itemIds: saved, file: file };
}

function finPengajuanPay_(itemIds, tanggalBayar, files, via) {
  tanggalBayar = finDate_(tanggalBayar);
  itemIds = (itemIds || []).map(String);
  if (!itemIds.length) throw new Error('Pilih item yang sudah dibayar.');
  var table = readTable_(FIN.ITEMS);
  var hits = table.rows.filter(function (r) { return itemIds.indexOf(r.item_id) >= 0; });
  if (!hits.length) throw new Error('Item tidak ditemukan.');
  var links = saveBukti_(files, tanggalBayar, 'Bukti Bayar ' + hits.map(function (r) { return r.keterangan; }).join(', ').slice(0, 60));
  var dates = {};
  hits.forEach(function (r) {
    var rec = cleanRecord_(r);
    rec.status = 'Lunas'; rec.tanggal_bayar = tanggalBayar;
    if (via === 'petty') rec.source = 'Petty Cash'; else if (via === 'owner') rec.source = 'Transfer Owner';
    rec.bukti_bayar = [r.bukti_bayar].concat(links).filter(String).join('\n');
    rec.updated_at = new Date();
    delete rec._row;
    writeObjectAt_(FIN.ITEMS, r._row, rec);
    dates[String(rec.tanggal_pengajuan).slice(0, 10)] = true;
  });
  SpreadsheetApp.flush();
  var files_ = Object.keys(dates).map(rebuildPengajuanFile_);
  syncPettyFromPengajuan_(itemIds);
  finLog_('PJ_PAY', { items: itemIds, tanggal_bayar: tanggalBayar, files: links.length });
  return { ok: true, files: files_, links: links };
}

function finPengajuanDelete_(itemId) {
  var table = readTable_(FIN.ITEMS);
  var hit = table.rows.filter(function (r) { return r.item_id === String(itemId); })[0];
  if (!hit) throw new Error('Item tidak ditemukan.');
  var tanggal = String(cleanRecord_(hit).tanggal_pengajuan).slice(0, 10);
  table.sheet.deleteRows(hit._row, 1);
  SpreadsheetApp.flush();
  var left = pjRows_().some(function (r) { return r.tanggal_pengajuan === tanggal; });
  var file = left ? rebuildPengajuanFile_(tanggal) : removeArchive_('PJ-' + tanggal);
  syncPettyFromPengajuan_([String(itemId)]);
  trashBukti_([hit.nota, hit.bukti_bayar].join('\n'));
  finLog_('PJ_DELETE', { item: itemId, tanggal: tanggal });
  return { ok: true, file: file };
}

/** Rebuilds "Pengajuan dan Reimbursment <tanggal> (WEB)" from the template (previous version goes to the trash). */
function rebuildPengajuanFile_(tanggal) {
  var items = pjRows_().filter(function (r) { return r.tanggal_pengajuan === tanggal; });
  // Keep items of the same recipient together so their Grand Total can be merged like PCC's own form.
  var order = [];
  items.forEach(function (it) { if (order.indexOf(it.atas_nama) < 0) order.push(it.atas_nama); });
  items.sort(function (a, b) { return order.indexOf(a.atas_nama) - order.indexOf(b.atas_nama); });
  var p = tanggal.split('-');
  var title = 'Pengajuan dan Reimbursment ' + Number(p[2]) + ' ' + MONTHS_ID[Number(p[1]) - 1].charAt(0) + MONTHS_ID[Number(p[1]) - 1].slice(1).toLowerCase() + ' ' + p[0] + ' (WEB)';
  var key = 'PJ-' + tanggal;
  var entry = null;
  readTable_(SHEET.ARCHIVE).rows.forEach(function (r) { if (String(r.tanggal) === key) entry = r; });
  var file = DriveApp.getFileById(finProp_('PENGAJUAN_TEMPLATE_ID')).makeCopy(title, DriveApp.getFolderById(finProp_('PENGAJUAN_FOLDER_ID')));
  try {
    fillPengajuan_(SpreadsheetApp.openById(file.getId()).getSheets()[0], tanggal, items);
  } catch (err) { file.setTrashed(true); throw err; }
  if (entry && entry.file_id) { try { DriveApp.getFileById(entry.file_id).setTrashed(true); } catch (e) { /* gone */ } }
  var url = 'https://docs.google.com/spreadsheets/d/' + file.getId() + '/edit';
  var rec = { tanggal: key, file_id: file.getId(), url: url, updated_at: new Date() };
  if (entry) writeObjectAt_(SHEET.ARCHIVE, entry._row, rec); else appendObjects_(SHEET.ARCHIVE, [rec]);
  return { status: 'ok', url: url, title: title };
}

function fillPengajuan_(sh, tanggal, items) {
  var extra = items.length - FIN.PJ_ROWS;
  if (extra > 0) {
    // Insert inside the item block so the TOTAL row's SUM range grows with it.
    sh.insertRowsBefore(FIN.PJ_FIRST + FIN.PJ_ROWS - 1, extra);
  }
  var n = Math.max(items.length, FIN.PJ_ROWS);
  var tz = sheetTz_(sh);
  sh.getRange(2, 1).setValue(finDateObj_(tanggal, tz));
  var rows = [], marks = [];
  for (var i = 0; i < n; i++) {
    var it = items[i];
    if (!it) { rows.push([i + 1, '', '', '', '', '', '']); marks.push(['', '', '', '', '', '', '']); continue; }
    rows.push([i + 1, it.keterangan, Number(it.qty) || 1, it.kategori, it.satuan, finDateObj_(it.tanggal_pengajuan, tz),
      it.tanggal_bayar ? finDateObj_(it.tanggal_bayar, tz) : '']);
    marks.push([Number(it.nominal) || 0, Number(it.dp) || '', it.tanggal_dp ? finDateObj_(it.tanggal_dp, tz) : '', '', '', '', '']);
  }
  sh.getRange(FIN.PJ_FIRST, 1, n, 7).setValues(rows);
  sh.getRange(FIN.PJ_FIRST, 8, n, 3).setValues(marks.map(function (m) { return m.slice(0, 3); }));
  var right = [];
  for (var j = 0; j < n; j++) {
    var x = items[j];
    right.push(x ? [x.atas_nama, x.no_rekening, x.bank, String(x.nota || ''), x.source,
      x.status === 'Lunas' ? ['LUNAS'].concat(String(x.bukti_bayar || '').split('\n').filter(String)).join('\n') : ''] : ['', '', '', '', '', '']);
  }
  sh.getRange(FIN.PJ_FIRST, 13, n, 6).setValues(right);
  for (var k = 0; k < n; k++) sh.getRange(FIN.PJ_FIRST + k, 11).setFormula('=SUM(H' + (FIN.PJ_FIRST + k) + '*C' + (FIN.PJ_FIRST + k) + ')');
  // Grand Total per recipient, merged over that recipient's rows.
  var start = 0;
  while (start < items.length) {
    var end = start;
    while (end + 1 < items.length && items[end + 1].atas_nama === items[start].atas_nama) end++;
    var r1 = FIN.PJ_FIRST + start, r2 = FIN.PJ_FIRST + end;
    if (r2 > r1) sh.getRange(r1, 12, r2 - r1 + 1, 1).merge();
    sh.getRange(r1, 12).setFormula('=SUM(K' + r1 + ':K' + r2 + ')');
    start = end + 1;
  }
}

// ---------------- summary for the website ----------------
function finSummary_() {
  var L = ledger_();
  var rows = ledgerRows_(L.sh);
  var items = pjRows_();
  var files = {};
  readTable_(SHEET.ARCHIVE).rows.forEach(function (r) { var t = String(r.tanggal); if (t.indexOf('PJ-') === 0) files[t.slice(3)] = String(r.url); });
  var groups = {};
  items.forEach(function (it) {
    var g = groups[it.tanggal_pengajuan] || (groups[it.tanggal_pengajuan] = { tanggal: it.tanggal_pengajuan, items: [], total: 0, lunas: 0, url: files[it.tanggal_pengajuan] || '' });
    var total = (Number(it.nominal) || 0) * (Number(it.qty) || 1);
    g.items.push(it); g.total += total; if (it.status === 'Lunas') g.lunas += total;
  });
  var uniq = function (list) { var o = {}; list.forEach(function (x) { if (x) o[x] = true; }); return Object.keys(o).sort(); };
  var accounts = {};
  items.forEach(function (it) { if (it.atas_nama) accounts[it.atas_nama] = { no_rekening: it.no_rekening, bank: it.bank }; });
  return {
    saldo: Number(L.sh.getRange(3, 5).getValue()) || 0,
    totalKredit: Number(L.sh.getRange(6, 5).getValue()) || 0,
    totalDebit: Number(L.sh.getRange(5, 5).getValue()) || 0,
    pettyUrl: L.ss.getUrl(),
    petty: rows.slice(-150).reverse(),
    pengajuan: Object.keys(groups).sort().reverse().map(function (k) { return groups[k]; }),
    suggest: {
      kategori: uniq(rows.map(function (r) { return r.kategori; })),
      akun: uniq(rows.map(function (r) { return r.akun; })).slice(0, 200),
      pjKategori: uniq(items.map(function (r) { return r.kategori; }).concat(['Invoice', 'Reimbursment', 'Listrik 1', 'Listrik 2', 'Listrik 3'])),
      satuan: uniq(items.map(function (r) { return r.satuan; }).concat(['Unit', 'Pcs', 'Paket'])),
      source: uniq(items.map(function (r) { return r.source; }).concat(['Transfer Owner', 'Petty Cash'])),
      accounts: accounts
    }
  };
}

// =====================================================================
// One-off from the editor: gather the old proof photos into BUKTI & LAMPIRAN/<YYYY-MM BULAN>.
// Each file keeps its own name with the date in front ("2026-04-08 IMG_0555.HEIC"); the date comes from
// the Petty Cash row that links to it, else from a date in its folder name, else from when it was uploaded.
// Run with dryRun=true first (organizeBuktiDryRun) to see the plan in the log.
// =====================================================================
var BUKTI_SOURCES = [
  '1pTgKtEcFyvkV93aMvlDfCPwl8LWm_yVM', '1oW5LYN2ryDd9O2SkKV4_lbL29EV6-vqY', '1JSHzPdK0saeUnDSsBFB5qd2UZUHt_Q0p',
  '1hhTA4NRHtc0lKIZBzfa1v68sR4HAyVGF', '1F98_dcsJlNPEzniZzGKYBjVUnIldHOc6', '1L1Ew6pai0O49GjqxVijxBZ3dm1f7RlUk',
  '15YrHDEw_AGFUltqIaRtoG4wF4dqmg78X', '1cmUuKwcY7zm7bmozu1PA4Smgre4AaVUp', '1ScqL7-UNGA1QBHuc1bgNhxunFyp8JLKT',
  '1RswxF9ZPr_aysbSsYIB6v7x77sEHapDR'
];

function organizeBuktiDryRun() { return organizeBukti(true); }

function organizeBukti(dryRun) {
  dryRun = dryRun === true;
  var linked = {};
  ledgerRows_(ledger_().sh).forEach(function (r) {
    (r.nota.match(/[-\w]{25,}/g) || []).forEach(function (id) { if (r.tanggal) linked[id] = r.tanggal; });
  });
  var MONTH_RE = /(\d{1,2})\s+(januari|februari|maret|april|mei|juni|juli|july|agustus|september|oktober|november|desember)\s+(\d{4})/i;
  var MONTH_IDX = { januari: 1, februari: 2, maret: 3, april: 4, mei: 5, juni: 6, juli: 7, july: 7, agustus: 8, september: 9, oktober: 10, november: 11, desember: 12 };
  var plan = [], seen = {};
  var walk = function (folder, folderDate) {
    var m = MONTH_RE.exec(folder.getName());
    if (m) folderDate = m[3] + '-' + ('0' + MONTH_IDX[m[2].toLowerCase()]).slice(-2) + '-' + ('0' + m[1]).slice(-2);
    var files = folder.getFiles();
    while (files.hasNext()) {
      var f = files.next();
      if (seen[f.getId()]) continue;
      seen[f.getId()] = true;
      var t = linked[f.getId()] || folderDate || Utilities.formatDate(f.getDateCreated(), 'Asia/Jakarta', 'yyyy-MM-dd');
      var name = /^\d{4}-\d{2}-\d{2} /.test(f.getName()) ? f.getName() : t + ' ' + f.getName();
      plan.push({ file: f, tanggal: t, name: name, from: folder.getName() });
    }
    var subs = folder.getFolders();
    while (subs.hasNext()) walk(subs.next(), folderDate);
  };
  BUKTI_SOURCES.forEach(function (id) { try { walk(DriveApp.getFolderById(id), null); } catch (e) { Logger.log('Lewati ' + id + ': ' + e); } });
  var folders = {};
  var monthFolder = function (t) { var k = t.slice(0, 7); return folders[k] || (folders[k] = buktiFolder_(t)); };
  var lines = plan.map(function (p) { return p.from + ' -> ' + p.tanggal.slice(0, 7) + ' / ' + p.name; });
  if (!dryRun) {
    plan.forEach(function (p) {
      p.file.moveTo(monthFolder(p.tanggal));
      if (p.name !== p.file.getName()) p.file.setName(p.name);
    });
  }
  Logger.log((dryRun ? 'RENCANA (belum dipindah) ' : 'DIPINDAH ') + plan.length + ' file:\n' + lines.join('\n'));
  return plan.length;
}

// ---------------- Petty Cash: real dates, one date format, rows in date order ----------------
var FIN_MONTHS = [['januari', 'january'], ['februari', 'february'], ['maret', 'march'], ['april'], ['mei', 'may'], ['juni', 'june'],
  ['juli', 'july'], ['agustus', 'august'], ['september'], ['oktober', 'october'], ['november'], ['desember', 'december']];
var LEDGER_DATE_FORMAT = 'd mmmm yyyy';

function editDistance_(a, b) {
  var d = [];
  for (var i = 0; i <= a.length; i++) { d[i] = [i]; for (var j = 1; j <= b.length; j++) d[i][j] = i ? 0 : j; }
  for (i = 1; i <= a.length; i++) for (j = 1; j <= b.length; j++) {
    d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
  }
  return d[a.length][b.length];
}

/** "9 Movember", "8 July 0226", "20 Juli", "1 Mei 2026" -> Date (year missing or mistyped -> fallbackYear). */
function parseLooseDate_(text, fallbackYear) {
  var m = /^\s*(\d{1,2})[\s\-\/.]+([A-Za-z]+)\.?(?:[\s\-\/.,]+(\d{2,4}))?\s*$/.exec(String(text || ''));
  if (!m) return null;
  var word = m[2].toLowerCase(), best = -1, bestD = 9;
  FIN_MONTHS.forEach(function (names, i) {
    names.forEach(function (name) {
      var dist = word.length >= 3 && name.indexOf(word) === 0 ? 0 : editDistance_(word, name);
      if (dist < bestD) { bestD = dist; best = i; }
    });
  });
  if (best < 0 || bestD > 2) return null;
  var y = Number(m[3]);
  if (!(y >= 2000 && y < 2100)) y = fallbackYear;
  var d = new Date(y, best, Number(m[1]));
  return d.getMonth() === best ? d : null;
}

/** Sorts the ledger rows by date; rows with the same date keep their order. */
function sortLedger_(sh) {
  var last = ledgerLastRow_(sh);
  var n = last - FIN.LEDGER_FIRST + 1;
  if (n < 2) return;
  var order = [];
  for (var i = 0; i < n; i++) order.push([i + 1]);
  var tmp = sh.getRange(FIN.LEDGER_FIRST, 17, n, 1);
  tmp.setValues(order);
  sh.getRange(FIN.LEDGER_FIRST, 8, n, 10).sort([{ column: 8, ascending: true }, { column: 17, ascending: true }]);
  tmp.clearContent();
}

/** From the editor: turns every text date into a real date, uses one date format, and sorts by date.
 *  rapikanPettyCashDryRun() only logs what would change. */
function rapikanPettyCashDryRun() { return rapikanPettyCash(true); }

function rapikanPettyCash(dryRun) {
  dryRun = dryRun === true;
  var sh = ledger_().sh;
  var last = ledgerLastRow_(sh);
  var n = last - FIN.LEDGER_FIRST + 1;
  if (n < 1) return 0;
  var vals = sh.getRange(FIN.LEDGER_FIRST, 8, n, 4).getValues();
  var shown = sh.getRange(FIN.LEDGER_FIRST, 8, n, 1).getDisplayValues();
  var isDate = function (v) { return Object.prototype.toString.call(v) === '[object Date]'; };
  var year = 2026, prev = null, changes = [], unknown = [], tz = sheetTz_(sh);
  var toSheet = function (d) { return finDateObj_(Utilities.formatDate(d, 'Asia/Jakarta', 'yyyy-MM-dd'), tz); };
  var out = vals.map(function (row, i) {
    var v = row[0], hasData = String(row[1]) + String(row[2]) + String(row[3]) !== '';
    if (isDate(v)) { year = Number(Utilities.formatDate(v, tz, 'yyyy')); prev = v; return [v]; }
    if (v === '' || v === null) {
      if (!hasData || !prev) return [v];
      changes.push('baris ' + (FIN.LEDGER_FIRST + i) + ': (kosong) -> ' + Utilities.formatDate(prev, 'Asia/Jakarta', 'd MMM yyyy') + ' (ikut baris di atasnya) · ' + row[1]);
      return [prev];
    }
    var d = parseLooseDate_(v, year);
    if (!d) { unknown.push('baris ' + (FIN.LEDGER_FIRST + i) + ': "' + shown[i][0] + '" · ' + row[1]); return [v]; }
    changes.push('baris ' + (FIN.LEDGER_FIRST + i) + ': "' + shown[i][0] + '" -> ' + Utilities.formatDate(d, 'Asia/Jakarta', 'd MMM yyyy') + ' · ' + row[1]);
    d = toSheet(d);
    prev = d;
    return [d];
  });
  if (!dryRun) {
    var col = sh.getRange(FIN.LEDGER_FIRST, 8, n, 1);
    col.setValues(out);
    col.setNumberFormat(LEDGER_DATE_FORMAT);
    sortLedger_(sh);
  }
  Logger.log((dryRun ? 'RENCANA ' : 'SELESAI ') + changes.length + ' tanggal diperbaiki' + (unknown.length ? ', ' + unknown.length + ' tidak dikenali' : '') +
    ':\n' + changes.join('\n') + (unknown.length ? '\nTidak dikenali (dibiarkan):\n' + unknown.join('\n') : ''));
  return changes.length;
}

/** One-off from the editor: the first run of rapikanPettyCash wrote dates at Jakarta midnight into a sheet whose
 *  time zone is not Jakarta, so they showed one day early. Every date is put back on the day it means. */
function perbaikiTanggalPettyCash() {
  var sh = ledger_().sh, tz = sheetTz_(sh);
  var n = ledgerLastRow_(sh) - FIN.LEDGER_FIRST + 1;
  if (n < 1) return 0;
  var rng = sh.getRange(FIN.LEDGER_FIRST, 8, n, 1);
  var vals = rng.getValues(), fixed = 0;
  var out = vals.map(function (v) {
    if (Object.prototype.toString.call(v[0]) !== '[object Date]') return v;
    var d = finDateObj_(Utilities.formatDate(v[0], 'Asia/Jakarta', 'yyyy-MM-dd'), tz);
    if (d.getTime() !== v[0].getTime()) fixed++;
    return [d];
  });
  rng.setValues(out);
  rng.setNumberFormat(LEDGER_DATE_FORMAT);
  sortLedger_(sh);
  Logger.log('Zona waktu sheet: ' + tz + '. Tanggal dikembalikan ke hari yang benar: ' + fixed);
  return fixed;
}

/** From the editor: when one tanggal + shift has more than one active report (from before reports were keyed by
 *  tanggal + shift only), keep one and delete the others. Kept: the only report with data in it; if several have
 *  data, the most recently updated. bersihkanLaporanDobelDryRun() only logs the plan. */
function bersihkanLaporanDobelDryRun() { return bersihkanLaporanDobel(true); }

function bersihkanLaporanDobel(dryRun) {
  dryRun = dryRun === true;
  var groups = {};
  activeReports_().forEach(function (r) { var k = PCC.reportKey(r.tanggal, r.shift); (groups[k] = groups[k] || []).push(r); });
  var lines = [], removed = 0;
  Object.keys(groups).forEach(function (k) {
    var list = groups[k];
    if (list.length < 2) return;
    var hasData = function (r) { return (Number(r.grand_total) || 0) > 0 || (Number(r.total_booking) || 0) > 0 || (Number(r.sales_qty) || 0) > 0; };
    var withData = list.filter(hasData);
    var pool = withData.length ? withData : list;
    pool.sort(function (a, b) { return String(b.updated_at).localeCompare(String(a.updated_at)); });
    var keep = pool[0];
    list.forEach(function (r) {
      if (r === keep) return;
      lines.push(k + ': hapus ' + r.report_id + ' (' + r.admin + ', ' + PCC.formatRupiah(r.grand_total) + '), simpan ' + keep.report_id + ' (' + keep.admin + ', ' + PCC.formatRupiah(keep.grand_total) + ')');
      if (!dryRun) { deleteReport_(r.report_id, 'Laporan dobel untuk ' + k + '; yang dipakai ' + keep.report_id); removed++; }
    });
  });
  Logger.log((dryRun ? 'RENCANA ' : 'SELESAI ') + (lines.length ? lines.join('\n') : 'tidak ada laporan dobel'));
  return dryRun ? lines.length : removed;
}

// ---------------- attachments kept / removed on edit ----------------
/** Lines of `current` (links or file names) that the user kept; the rest are moved to the Drive trash.
 *  `keep` undefined = keep everything (older clients). */
function keepLinks_(current, keep) {
  var lines = String(current || '').split('\n').map(function (x) { return x.trim(); }).filter(String);
  if (!Array.isArray(keep)) return lines;
  var kept = lines.filter(function (x) { return keep.indexOf(x) >= 0; });
  trashBukti_(lines.filter(function (x) { return kept.indexOf(x) < 0; }).join('\n'));
  return kept;
}

/** Moves uploaded proof files to the Drive trash — only files inside BUKTI & LAMPIRAN, never anything else. */
function trashBukti_(text) {
  var root = PropertiesService.getScriptProperties().getProperty('BUKTI_FOLDER_ID');
  (String(text || '').match(/\/d\/([-\w]{25,})/g) || []).forEach(function (m) {
    try {
      var f = DriveApp.getFileById(m.slice(3));
      var inBukti = false, p = f.getParents();
      while (p.hasNext() && !inBukti) {
        var folder = p.next();
        if (folder.getId() === root) inBukti = true;
        var up = folder.getParents();
        while (up.hasNext()) if (up.next().getId() === root) inBukti = true;
      }
      if (inBukti) f.setTrashed(true);
    } catch (e) { /* already gone or not ours */ }
  });
}

// ---------------- Pengajuan -> Petty Cash ----------------
/** Each paid (Lunas) pengajuan item has one Petty Cash row, linked by its item_id in column P.
 *  Paid by owner transfer: Kredit and Debit (money in and straight out). Paid from petty cash: Debit only.
 *  Unpaid or deleted items lose their row. */
function syncPettyFromPengajuan_(itemIds) {
  if (!itemIds || !itemIds.length || !PropertiesService.getScriptProperties().getProperty('PETTY_CASH_ID')) return;
  var items = {};
  pjRows_().forEach(function (it) { items[it.item_id] = it; });
  var L = ledger_(), sh = L.sh;
  var byRef = {};
  ledgerRows_(sh).forEach(function (r) { if (r.ref) byRef[r.ref] = r; });
  var removeRows = [];
  itemIds.forEach(function (id) {
    var it = items[id], row = byRef[id];
    if (!it || it.status !== 'Lunas') { if (row) removeRows.push(row.row); return; }
    var total = (Number(it.nominal) || 0) * (Number(it.qty) || 1);
    var viaPetty = /petty/i.test(String(it.source));
    var e = {
      tanggal: it.tanggal_bayar || it.tanggal_pengajuan,
      transaksi: 'Pengajuan: ' + it.keterangan + ((Number(it.qty) || 1) > 1 ? ' (' + it.qty + ' ' + (it.satuan || 'x') + ')' : ''),
      kredit: viaPetty ? 0 : total, debit: total, kategori: it.kategori || 'Pengajuan', akun: it.atas_nama
    };
    var nota = [it.nota, it.bukti_bayar].join('\n').split('\n').filter(function (x) { return x.trim(); }).join('\n');
    var at = row ? row.row : ledgerLastRow_(sh) + 1;
    if (!row) {
      if (at > sh.getMaxRows()) sh.insertRowsAfter(sh.getMaxRows(), 50);
      if (at - 1 >= FIN.LEDGER_FIRST) sh.getRange(at - 1, 8, 1, 7).copyTo(sh.getRange(at, 8, 1, 7), { formatOnly: true });
    }
    writeLedgerRow_(sh, at, e, nota);
    sh.getRange(at, 16).setValue(id);
  });
  removeRows.sort(function (a, b) { return b - a; }).forEach(function (r) { sh.deleteRow(r); });
  sortLedger_(sh);
}
